# AutoAnime Shorts Environment Configuration
# Copy this file to .env to override defaults

# Server Config
HOST=127.0.0.1
PORT=7860
DEBUG=false

# Hardware & VRAM
DEVICE=cuda
VRAM_BUDGET_GB=8.0
HALF_PRECISION=true

# Prompter Engine
LLM_BACKEND=llama_cpp
LLM_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
LLM_GPU_LAYERS=33

# Image Engine (SD 1.5 Anime)
IMAGE_BACKEND=diffusers
IMAGE_MODEL_ID=gsdf/Counterfeit-V3.0

# TTS Engine (Offline Kokoro-82M)
TTS_BACKEND=kokoro
TTS_VOICE=af_sky
TTS_SPEED=1.05

# Upload Settings
AUTO_UPLOAD=false
UPLOAD_YOUTUBE=false
UPLOAD_TIKTOK=false
UPLOAD_INSTAGRAM=false
